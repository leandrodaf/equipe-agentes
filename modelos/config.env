# Configuração da equipe de agentes deste projeto (lida pelo bash e pelo Python: KEY=valor, aspas
# como no shell). Só o que mudar do padrão precisa estar aqui; a lista completa e os padrões estão
# em lib/config.py do equipe-agentes. Os valores aparecem nos prompts como {{CHAVE}}.

# Nome curto do projeto: identifica os agentes (claude-1@<projeto>), a sessão tmux e o painel.
PROJETO={{PROJETO}}
DESCRICAO="{{DESCRICAO}}"

# Ramo principal, onde os itens aprovados entram (só por fast-forward).
RAMO={{RAMO}}

# A fila: o arquivo de itens e o arquivo dos encerrados (podem ficar fora do git) e o prefixo dos IDs.
FILA=MELHORIAS.md
ARQUIVO_FILA=MELHORIAS-ARQUIVO.md
PREFIXO=MEL
CHANGELOG=CHANGELOG.md
LIMITE_VIVOS=20

# O gate: o comando que o implementador roda uma vez, verde, antes de entregar um item.
GATE="make test"
# Prepara uma worktree nova (instala dependências). Vazio: nada a instalar.
INSTALAR=""
# Como rodar só o teste do que mudou, durante o desenvolvimento (texto para o prompt).
TESTE_RAPIDO=""

# 1: a analista dá push do ramo principal no origin depois de cada integração. 0: ninguém dá push.
PUSH=0

# O app do dono (o que roda de verdade e ninguém pode derrubar). Tudo opcional.
APP_URL=""
PORTAS_DONO=""
# APP_ATIVO: sai 0 se o app está no ar; APP_SUBIR: o `equipe subir` roda se não estiver.
APP_ATIVO=""
APP_SUBIR=""
# APP_PARAR: o `equipe parar APP=1` roda para desligar o app também.
APP_PARAR=""

# Faixas de porta para os ambientes isolados (a analista e os implementadores).
PORTAS_ANALISTA=8090-8099
PORTAS_IMPLEMENTADOR=8100-8199

# Painel web da equipe. PAINEL_IP_EXTRA: um IP privado a mais para escutar (túnel até o celular).
PAINEL_PORTA=8077
PAINEL_IP_EXTRA=""
# Pasta (relativa ao projeto) com evidências que o painel mostra junto dos prints dos agentes.
EVIDENCIAS=docs/evidencias

# Quantos agentes o `equipe subir` abre e o supervisor mantém.
N_CLAUDE=3
N_CODEX=3
N_DEEP=0
# Argumentos extras para cada ferramenta (ex.: CLAUDE_ARGS="--model opus").
CLAUDE_ARGS=""
CODEX_ARGS=""
# Função do ~/.zshrc que abre o Claude Code apontado para a DeepSeek (só com N_DEEP > 0).
DEEP_COMANDO=claude-deep
